# =========================================================
# PORTFOLIO ENV TEMPLATE — .env.example
# এই ফাইলটি GitHub-এ থাকবে (সিক্রেট নেই)
# .env ফাইল বানাতে এটা কপি করুন এবং আসল মান বসান
# =========================================================

LOCAL_MODE=true

ADMIN_PASSWORD=your_secure_admin_password_here
JWT_SECRET=your_long_random_jwt_secret_at_least_32_characters

# MongoDB Atlas URI (production-এ দিন)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio

# Cloudinary (production-এ দিন)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

API_PORT=3001
